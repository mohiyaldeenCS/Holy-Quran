<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- From Android 12 the system draws its own launch screen and ignores
         windowBackground. It cannot show the lockup, so it shows the mark on
         emerald-700 instead. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_emerald_700</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
