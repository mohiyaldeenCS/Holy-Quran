<?xml version="1.0" encoding="utf-8"?>
<!-- Spike S4 (D-068, D-094): one image Flutter rendered, no text of its own.
     The launcher clips @android:id/background to its radius (D-093, reading 3). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spike_widget_ground"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/ayah_widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone" />
</FrameLayout>
