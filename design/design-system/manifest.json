  "components": [
    {
      "name": "Mark",
      "group": "الهوية",
      "summary": "رمز التطبيق: نجمة الربع (مربعان متراكبان) تحتضن كتابًا مفتوحًا، وفوقه النقطة العلوية التي تعني «موضع القراءة الحالي»."
    },
    {
      "name": "Lockup",
      "group": "الهوية",
      "summary": "الرمز مع الاسم «القرآن الكريم» بخط ريم كوفي ٧٠٠. الرمز على يمين الاسم لأن القراءة تبدأ منه."
    },
    {
      "name": "Icon",
      "group": "الهوية",
      "summary": "مجموعة أيقونات خطية على شبكة ٢٤: خط ١٫٧٥ بأطراف مدوّرة، بلا تعبئة إلا التشغيل والإيقاف. تأخذ لونها من currentColor."
    },
    {
      "name": "Button",
      "group": "الإجراءات",
      "summary": "الأزرار: ارتفاع ٥٢، زوايا ١٦، نص ١٧ نصف عريض. الارتفاع الأدنى ٤٨ والنص لا ينقص عن ١٧."
    },
    {
      "name": "IconButton",
      "group": "الإجراءات",
      "summary": "زر أيقونة دائري، ٤٨ بكسل افتراضيًا. label إلزامي لأنه الاسم الذي يقرؤه قارئ الشاشة."
    },
    {
      "name": "LevelSwitch",
      "group": "التحكم",
      "summary": "مفتاح مستوى الواجهة: بسيط · متوسط · دراسة. يغيّر الأدوات الظاهرة في التطبيق كله من إعداد واحد."
    },
    {
      "name": "Tag",
      "group": "التحكم",
      "summary": "وسم تصنيف للعلامات والملاحظات والمجموعات. لكل تصنيف شكل ولون واسم، فلا يُترك التمييز للون وحده."
    },
    {
      "name": "Switch",
      "group": "التحكم",
      "summary": "مفتاح تشغيل وإيقاف للإعدادات، ٥٦×٣٢ داخل صف ارتفاعه ٤٨. عند التفعيل تكون الدائرة على اليسار والمسار زمرديًا."
    },
    {
      "name": "AyahMarker",
      "group": "المصحف",
      "summary": "فاصلة الآية: دائرة ذهبية رقيقة (ornament) ورقم الآية بداخلها بخط الواجهة ٦٠٠ بلون accent."
    },
    {
      "name": "QuranText",
      "group": "المصحف",
      "summary": "حاوية النص القرآني بخط أميري قرآن. size: page (٢٥/٢٫٣ لصفحة المصحف)، ayah (٣٤/٢٫٣)، focus (٤٤/٢)، compact (٢٢/٢٫٢ لنتائج البحث وورقة السياق والحفظ)."
    },
    {
      "name": "SurahHeader",
      "group": "المصحف",
      "summary": "رأس السورة: إطار مزدوج (خارجي ١٫٥ بلون ornament وداخلي ١ بلون ornament-soft) ونجمتا الربع على الجانبين، والاسم بخط ريم كوفي ٦٠٠ بلون primary."
    },
    {
      "name": "AyahRow",
      "group": "المصحف",
      "summary": "الآية بطاقةً مستقلة لوضع الدراسة والبحث والعلامات: فاصلتها، ثم ثلاثة أفعال (تشغيل من هنا، علامة مرجعية، مركز الدراسة)، ثم النص بحجم quran-ayah."
    },
    {
      "name": "SurahListItem",
      "group": "المصحف",
      "summary": "صف فهرس السور: الرقم داخل نجمة الربع، والاسم بخط ريم كوفي، ثم «مكية/مدنية · عدد الآيات»، وصفحة البداية."
    },
    {
      "name": "ProgressBar",
      "group": "الصوت والتقدّم",
      "summary": "شريط تقدّم يمتلئ من بداية السطر، أي من اليمين، مثل اتجاه القراءة."
    },
    {
      "name": "MiniPlayer",
      "group": "الصوت والتقدّم",
      "summary": "بطاقة المشغّل الزمردية: السورة والآية بخط ريم كوفي، واسم القارئ، والسرعة، وشريط تقدّم ذهبي، وخمسة أزرار: تكرار، والآية السابقة، وتشغيل/إيقاف (ذهب ٦٠ بكسل)، وال…"
    },
    {
      "name": "ContinueCard",
      "group": "الصوت والتقدّم",
      "summary": "بطاقة «أكمل القراءة» في الرئيسية: زمرد بنجمة ذهبية خافتة في الزاوية، واسم السورة بخط ريم كوفي ٣٢، والموضع، والتقدّم في المصحف، وزر «تابع القراءة»."
    },
    {
      "name": "ResourceRow",
      "group": "الصوت والتقدّم",
      "summary": "صف في مدير الموارد: تفاسير، وتلاوات، وروايات، وموارد لغوية."
    },
    {
      "name": "TajweedKey",
      "group": "المصحف",
      "summary": "مفتاح أحكام التجويد الثمانية. لكل حكم لون (tj-*) وعلامة خطية واسم، فلا يُترك التمييز لحاسة اللون وحدها."
    },
    {
      "name": "TabBar",
      "group": "التنقل والدراسة",
      "summary": "شريط التنقل السفلي بخمسة أقسام: الرئيسية، المصحف، الاستماع، الدراسة، المزيد. القسم النشط بحبّة زمردية فاتحة خلف أيقونته."
    },
    {
      "name": "WordSheet",
      "group": "التنقل والدراسة",
      "summary": "الورقة المنزلقة لدراسة كلمة: تبويبات (النص، التفسير، الإعراب، الصرف، التجويد)، ثم الكلمة بحجم quran-focus، ثم صفوف «تسمية · قيمة»."
    },
    {
      "name": "SearchField",
      "group": "البحث",
      "summary": "حقل البحث: أيقونة، ونص ١٨ نصف عريض، وزر الميكروفون ٤٨ لـ«اقرأ جزءًا من الآية». ارتفاعه ٥٦، وحدّه line-strong، ويصير زمرديًا ٢ بكسل حين يأخذ التركيز."
    },
    {
      "name": "ModeChips",
      "group": "البحث",
      "summary": "حبّات أنواع البحث: كلمة، الجذر، بلا تشكيل، المشتقات، في التفاسير، الموضوعات. واحد منها مختار دائمًا."
    },
    {
      "name": "SearchSummary",
      "group": "البحث",
      "summary": "سطر ما بحثتَ عنه وعدد نتائجه، وفي آخره زر الترتيب (ترتيب المصحف، الأقرب، الأكثر ورودًا)."
    },
    {
      "name": "SearchResult",
      "group": "البحث",
      "summary": "بطاقة نتيجة واحدة: الموضع («البقرة · الآية ٤٥»)، وزرّان (سياق الآية، افتح في المصحف)، ثم الآية كاملة بخط المصحف ٢٢."
    },
    {
      "name": "ContextSheet",
      "group": "البحث",
      "summary": "ورقة منزلقة تُظهر الآية بين ما قبلها وما بعدها، تُفتح من زر «سياق الآية» في نتيجة البحث."
    },
    {
      "name": "RepeatDots",
      "group": "الحفظ",
      "summary": "نقاط عدّاد التكرار: المنجز مملوء بالزمرد، والجاري حلقة ذهبية ٣ بكسل بداخلها ذهب فاتح، والقادم حلقة فارغة بحدّ line-strong. الأشكال الثلاثة تختلف بالتعبئة والسُ…"
    },
    {
      "name": "SessionStatus",
      "group": "الحفظ",
      "summary": "بطاقة رأس جلسة الحفظ: «الخطوة ٤ من ٩» بلون accent، ثم «الآية ٣ · التكرار ٤ من ٧»، وفي آخرها RepeatDots."
    },
    {
      "name": "ConcealedText",
      "group": "الحفظ",
      "summary": "نص الحفظ بعد حجب حبره. لا يُحذف شيء: النص باقٍ كلمةً كلمة تحت شريط conceal (خط سفلي line-strong وشريط بطول الكلمة)، فيبقى موضع كل كلمة وطولها ظاهرين ليتذكّر ال…"
    },
    {
      "name": "SessionBar",
      "group": "الحفظ",
      "summary": "الشريط الزمردي العائم أسفل جلسة الحفظ: إيقاف مؤقت/متابعة (ذهب ٥٢)، وما يجري الآن، وزر الخطوة التالية (٤٨)."
    },
    {
      "name": "Stepper",
      "group": "الحفظ",
      "summary": "رقم يُعدَّل بزرّي إنقاص وزيادة، كلٌّ منهما بحجم لمس ٤٨. للإعدادات الصغيرة: عدد التكرار، وتكرار الدمج، ومدة الصمت."
    },
    {
      "name": "PlanStep",
      "group": "الحفظ",
      "summary": "صف من تسلسل الجلسة في خطة الحفظ: الآية ثم تكرارها، وبعد كل آية جديدة «دمج» بما سبقها: ١ ثم ٢ ثم ١–٢ معًا ثم ٣ ثم ١–٣ معًا، وهكذا."
    }
  ],
