# Text files are LF in the repository and in every checkout, whatever
# core.autocrlf says: the generator, the guards and the integrity tests compare
# bytes, and their outputs and fixtures are written with LF.
* text=auto eol=lf
*.png binary
*.ico binary

# Files whose bytes are pinned or copied from an approved source are never
# line-ending converted, so that their hashes hold on every platform.
docs/prd/PRD.ar.md -text
design/design-system/** -text
design/identity-boards/** -text
.claude/skills/** -text
*.ttf binary
*.woff2 binary
assets/licenses/** -text
